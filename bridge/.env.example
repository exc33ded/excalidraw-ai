# Copy to bridge/.env (gitignored). Never commit the real key.
# Any OpenAI-compatible endpoint works (DeepSeek, GLM, OpenAI, local).
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key
AI_API_MODEL=gpt-4o
AI_AGENT_MODEL=deepseek-v4-flash
PORT=8787
# Models the chat picker offers, comma-separated: id[:vision][:maxTokens].
# The server refuses any model not on this list. Defaults to AI_AGENT_MODEL alone.
AI_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp:vision
# Optional hardening. AI_BRIDGE_HOST=0.0.0.0 to expose beyond localhost; then set a token
# (the browser sends it as Authorization: Bearer) and pin ALLOWED_ORIGIN.
AI_BRIDGE_HOST=127.0.0.1
#AI_BRIDGE_TOKEN=
#ALLOWED_ORIGIN=http://localhost:5173
#AI_TIMEOUT_MS=180000
