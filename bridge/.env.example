# Copy to bridge/.env (gitignored). Never commit the real key.
# Any OpenAI-compatible /chat/completions endpoint works. Pick ONE preset.

# --- Preset A: OpenAI ---------------------------------------------------------
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key
# vision model for Refine and the capture tool (also used by /api/ai/diagram)
AI_API_MODEL=gpt-4o
# default chat (agent) model
AI_AGENT_MODEL=gpt-4o-mini
# Models the panel's settings offer: id[:vision][:maxTokens], comma-separated.
# The server refuses any model not on this list. maxTokens defaults to 32000,
# which suits reasoning models; OpenAI models need a smaller output budget.
AI_MODELS=gpt-4o-mini:16000,gpt-4o:vision:16000

# --- Preset B: DeepSeek (reasoning models, large output budget) ----------------
#AI_API_URL=https://api.deepseek.com/v1
#AI_API_KEY=sk-your-key
#AI_API_MODEL=deepseek-v4-flash-vision-exp
#AI_AGENT_MODEL=deepseek-v4-flash
#AI_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp:vision

PORT=8787
# Optional hardening. AI_BRIDGE_HOST=0.0.0.0 to expose beyond localhost; then
# set a token (the browser sends it as Authorization: Bearer, from
# VITE_AI_BRIDGE_TOKEN in bridge/host/.env) and pin ALLOWED_ORIGIN.
AI_BRIDGE_HOST=127.0.0.1
#AI_BRIDGE_TOKEN=
#ALLOWED_ORIGIN=http://localhost:5173
#AI_TIMEOUT_MS=180000
